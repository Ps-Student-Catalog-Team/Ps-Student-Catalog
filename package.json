{
  "name": "ps-student-catalog",
  "version": "1.0.0",
  "description": "Student Catalog Electron App",
  "main": "main.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "cz-conventional-changelog": "^3.3.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.example.psstudentcatalog",
    "productName": "Ps-Student-Catalog",
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!server/**/*",
      "!status/**/*",
      "!tutorial/**/*",
      "!password/**/*",
      "!parsedown-1.7.4/**/*"
    ],
    "asar": true
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
